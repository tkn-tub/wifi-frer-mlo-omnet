#
# Usage:
#    make -f makemakefiles
# or, for Microsoft Visual C++:
#    nmake -f makemakefiles MMOPT=-n
#

MAKEMAKE=opp_makemake $(MMOPT)

INET_4_7_0_PROJ=../inet-4.7.0
MLO_PROJ=../mlo

all:
	$(MAKEMAKE) --make-so -f --deep -O out -KINET_4_7_0_PROJ=../inet-4.7.0 -KMLO_PROJ=../mlo -DINET_IMPORT -I. -I$$\(INET_4_7_0_PROJ\)/src -I$$\(MLO_PROJ\) -L$$\(INET_4_7_0_PROJ\)/src -L$$\(MLO_PROJ\) -lINET$$\(D\) -lmlo$$\(D\)
